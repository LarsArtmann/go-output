{
  "name": "go-output-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website and documentation for go-output — write your data once, render it anywhere",
  "keywords": [
    "astro",
    "cli",
    "code-quality",
    "diagrams",
    "formatting",
    "go",
    "go-output",
    "golang",
    "output",
    "starlight",
    "tables"
  ],
  "homepage": "https://go-output.lars.software",
  "bugs": "https://github.com/larsartmann/go-output/issues",
  "license": "MIT",
  "author": "LarsArtmann <lars@larsartmann.com> (https://larsartmann.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/larsartmann/go-output.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-csp.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "verify": "pnpm run typecheck && pnpm run build && pnpm exec html-validate --config .htmlvalidate.json \"dist/**/*.html\"",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.41.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.1",
    "astro-og-canvas": "0.13.1",
    "canvaskit-wasm": "0.41.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "html-validate": "^11.12.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.20.0"
}
