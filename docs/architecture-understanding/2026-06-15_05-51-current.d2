direction: down

core: {
  label: Core Layer
  style.fill: "#e3f2fd"
  style.stroke: "#1976d2"

  root: {
    label: |go
      root (package output)
      Core types, enums, shape matrix,
      Registry dispatch, Markdown, Tree
    |
    shape: rectangle
  }

  enum: {
    label: |go
      enum/
      Generic enum utilities
      Zero deps
    |
    shape: rectangle
  }

  escape: {
    label: |go
      escape/
      Format escaping
      Zero deps
    |
    shape: rectangle
  }

  testhelpers: {
    label: |go
      testhelpers/
      Shared assertions
      Zero deps
    |
    shape: rectangle
  }
}

formatters: {
  label: Formatter Layer
  style.fill: "#f3e5f5"
  style.stroke: "#7b1fa2"

  delimited: {label: |go delimited/ CSV + TSV |; shape: rectangle}
  serialization: {label: |go serialization/ JSON + YAML + TOML + JSONL |; shape: rectangle}
  markup: {label: |go markup/ XML + HTML + AsciiDoc |; shape: rectangle}
  table: {label: |go table/ Lipgloss tables |; shape: rectangle}
  d2: {label: |go d2/ D2 diagrams |; shape: rectangle}
  graph: {label: |go graph/ DOT + Mermaid |; shape: rectangle}
  plantuml: {label: |go plantuml/ PlantUML |; shape: rectangle}
}

progress: {
  label: Progress Layer
  style.fill: "#fff3e0"
  style.stroke: "#f57c00"

  nom: {
    label: |go
      nom/
      NOM-style real-time progress
      Subscriber + DependencyTree
      InlineRenderer + TimingCache
    |
    shape: rectangle
  }

  tui: {
    label: |go
      tui/
      Bubble Tea interactive TUI
      (depends on nom + bubbletea)
    |
    shape: rectangle
  }
}

aggregators: {
  label: Leaf Aggregators
  style.fill: "#e8f5e9"
  style.stroke: "#388e3c"

  integration: {label: |go integration/ Cross-module tests |; shape: rectangle}
  examples: {label: |go examples/ Usage demos |; shape: rectangle}
}

external: {
  label: External Deps
  style.fill: "#fafafa"
  style.stroke: "#9e9e9e"

  lipgloss: {label: "charm.land/lipgloss/v2"; shape: circle}
  bubbletea: {label: "charm.land/bubbletea/v2"; shape: circle}
  yaml: {label: "go-faster/yaml"; shape: circle}
  toml: {label: "pelletier/go-toml/v2"; shape: circle}
  term: {label: "golang.org/x/term"; shape: circle}
  branded: {label: "go-branded-id"; shape: circle}
}

# Core internal
root -> enum: uses
root -> term: uses
root -> branded: uses

# Formatters -> Core
delimited -> root: imports
serialization -> root: imports
markup -> root: imports
markup -> escape: imports
table -> root: imports
d2 -> root: imports
d2 -> escape: imports
d2 -> testhelpers: tests
graph -> root: imports
graph -> escape: imports
graph -> testhelpers: tests
plantuml -> root: imports

# Formatters -> External
table -> lipgloss: imports
serialization -> yaml: imports
serialization -> toml: imports

# Progress -> Core + External
nom -> root: imports
nom -> lipgloss: imports
tui -> nom: imports
tui -> bubbletea: imports
tui -> lipgloss: imports

# Aggregators -> everything
integration -> root: tests
integration -> nom: tests
integration -> tui: tests
examples -> root: demos
examples -> nom: demos
examples -> tui: demos
