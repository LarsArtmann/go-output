root -> testhelpers: test deps
root -> escape: (via replace)

delimited -> root: core types
serialization -> root: core types
markup -> root: core types
table -> root: core types
markdown -> root: core types
tree -> root: core types
d2mod -> root: core types
graph -> root: core types
plantuml -> root: core types
nom -> root: core types
tui -> root: core types

d2mod -> escape: escaping
graph -> escape: escaping
markup -> escape: escaping
plantuml -> escape: escaping

graphtest -> testhelpers: shared fixtures

tui -> nom: progress events

integration -> root: cross-module tests
integration -> d2mod: cross-module tests
integration -> graph: cross-module tests
integration -> table: cross-module tests
integration -> nom: cross-module tests

examples -> root: examples
examples -> table: examples
examples -> nom: examples
examples -> tui: examples
